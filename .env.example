# Copy to .env (project root in the Editor, next to UnityAiNpc.exe in a build).
# Real environment variables override this file.

# OpenAI key. Leave empty to play with scripted offline replies.
OPENAI_API_KEY=

# Any OpenAI-compatible Chat Completions server works.
# Local Ollama (no key needed):  OPENAI_BASE_URL=http://localhost:11434/v1  and  OPENAI_MODEL=llama3.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional
# OPENAI_ORG_ID=
# OPENAI_TIMEOUT_SECONDS=30
# AI_NPC_OFFLINE=1        # force scripted replies even when a key is set
BATCH_INSERT=enabled